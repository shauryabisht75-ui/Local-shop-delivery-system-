// SHOP MANAGEMENT: hash tables for shop inventory and for the product catalog
struct InvNode { int shopId; int productId; double price; int stock; InvNode* next; };
// hash table with chaining: key = (shopId, productId)
class InventoryTable {
    InvNode* bucket[HASH_SIZE];
    int hashKey(int shopId, int productId) { return (shopId * 31 + productId) % HASH_SIZE; }
public:
    InventoryTable() { for (int i = 0; i < HASH_SIZE; i++) bucket[i] = NULL; }
    InvNode* find(int shopId, int productId) {
        for (InvNode* p = bucket[hashKey(shopId, productId)]; p != NULL; p = p->next)
            if (p->shopId == shopId && p->productId == productId) return p;
        return NULL;
    }
void set(int shopId, int productId, double price, int stock) {
        InvNode* p = find(shopId, productId);
        if (p != NULL) { p->price = price; p->stock = stock; return; }
        p = new InvNode;
        p->shopId = shopId; p->productId = productId; p->price = price; p->stock = stock;
        int h = hashKey(shopId, productId);
        p->next = bucket[h];
        bucket[h] = p;
}
    bool remove(int shopId, int productId) {
        int h = hashKey(shopId, productId);
        InvNode* prev = NULL;
        for (InvNode* p = bucket[h]; p != NULL; prev = p, p = p->next)
            if (p->shopId == shopId && p->productId == productId) {
                if (prev == NULL) bucket[h] = p->next; else prev->next = p->next;
                delete p;
                return true;
            }
        return false;
    }
InvNode* head(int i) { return bucket[i]; }
};
// hash table: lower-case product name -> product id (stops duplicate products)
struct NameNode { string key; int productId; NameNode* next; };
class NameTable {
    NameNode* bucket[HASH_SIZE];
    int hashText(const string& s) {
        unsigned int h = 0;
        for (size_t i = 0; i < s.size(); i++) h = h * 31 + (unsigned char)s[i];
        return (int)(h % HASH_SIZE);
    }
public:
    NameTable() { for (int i = 0; i < HASH_SIZE; i++) bucket[i] = NULL; }
    void insert(const string& key, int productId) {
        NameNode* n = new NameNode;
        n->key = key; n->productId = productId;
        int h = hashText(key);
        n->next = bucket[h];
        bucket[h] = n;
    }
int find(const string& key) {
        for (NameNode* p = bucket[hashText(key)]; p != NULL; p = p->next)
            if (p->key == key) return p->productId;
        return 0;
    }
};
