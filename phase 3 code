// settlement: how the money of every DELIVERED order is split
void Admin::settlementReport() {
    int counts[8] = {0, 0, 0, 0, 0, 0, 0, 0};
    double sales = 0, collected = 0, shopPay = 0, agentPay = 0, platform = 0;
    for (Order* o = orderHead; o != NULL; o = o->next) {
        counts[o->status]++;
        if (o->status == ST_DELIVERED) {
            sales += o->itemTotal;
            collected += grandTotal(o);
            shopPay += shopEarning(o);
            agentPay += agentEarning(o);
            platform += platformEarning(o);
        }
    }
    cout << "\nORDER COUNT BY STATUS\n";
    for (int i = 0; i < 8; i++) printf("  %-15s %d\n", STATUS_NAME[i], counts[i]);
    printf("\nSETTLEMENT (delivered orders only)\n");
    printf("  Total paid by customers : %s\n", money(collected).c_str());
    printf("  Item sales              : %s\n", money(sales).c_str());
    printf("  Payable to shops        : %s  (item total - %.0f%% commission)\n", money(shopPay).c_str(), COMMISSION_PERCENT);
    printf("  Payable to agents       : %s  (%.0f%% of delivery fees)\n", money(agentPay).c_str(), AGENT_SHARE_PERCENT);
    printf("  PLATFORM PROFIT         : %s  (commission + fees)\n", money(platform).c_str());
    printf("\nPER SHOP\n%-24s %-10s %-14s %s\n", "Shop", "Delivered", "Sales", "Payout");
    for (int i = 0; i < shopCount; i++) {
        int d = 0;
        double sl = 0, pay = 0;
        for (Order* o = orderHead; o != NULL; o = o->next)
            if (o->shopId == shops[i].id && o->status == ST_DELIVERED) { d++; sl += o->itemTotal; pay += shopEarning(o); }
        printf("%-24s %-10d %-14s %s\n", shops[i].name.c_str(), d, money(sl).c_str(), money(pay).c_str());
    }
}

