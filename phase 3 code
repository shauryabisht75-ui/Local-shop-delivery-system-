// ORDER MANAGEMENT: linked list of orders, status flow, allocation, fees, ETA
Order* findOrder(int id) {
    for (Order* o = orderHead; o != NULL; o = o->next)
        if (o->id == id) return o;
    return NULL;
}
User* findUser(int id) {
    for (int i = 0; i < userCount; i++)
        if (users[i]->id == id) return users[i];
    return NULL;
}
// only these status changes are allowed
bool validMove(int from, int to) {
    if (from == ST_PLACED)
        return to == ST_ACCEPTED || to == ST_CANCELLED || to == ST_REJECTED;
    if (from == ST_ACCEPTED)
        return to == ST_PACKED || to == ST_CANCELLED || to == ST_REJECTED;
    if (from == ST_PACKED) return to == ST_AGENT_ASSIGNED;
    if (from == ST_AGENT_ASSIGNED) return to == ST_PICKED_UP;
    if (from == ST_PICKED_UP) return to == ST_DELIVERED;
    if (from == ST_REJECTED) return to == ST_PLACED;   // re-allocated to the next shop
    return false;
}
bool changeStatus(Order* o, int to) {
    if (!validMove(o->status, to)) {
        cout << "  Invalid status change: " << STATUS_NAME[o->status] << " -> " << STATUS_NAME[to] << "\n";
        return false;
    }
    o->status = to;
    return true;
}
// appends a new order at the end of the linked list
Order* newOrderNode() {
    Order* o = new Order();
    o->id = nextOrderId++;
    o->next = NULL;
    if (orderTail == NULL) { orderHead = o; orderTail = o; }
    else { orderTail->next = o; orderTail = o; }
    return o;
}
Payment* findPayment(int orderId) {
    for (int i = 0; i < paymentCount; i++)
        if (payments[i].orderId == orderId) return &payments[i];
    return NULL;
}
Payment* addPayment(int orderId, int mode, int status) {
    if (paymentCount >= MAX_PAYMENTS) return NULL;
    Payment& p = payments[paymentCount++];
    p.id = nextPaymentId++; p.orderId = orderId; p.mode = mode; p.status = status;
    return &p;
}
void refundIfPaid(Order* o) {
    Payment* p = findPayment(o->id);
    if (p != NULL && p->status == PS_PAID) {
        p->status = PS_REFUNDED;
        cout << "  Payment of " << money(grandTotal(o)) << " will be refunded to the customer.\n";
    }
}
const char* payModeName(int mode) {
    if (mode == PAY_COD) return "Cash on Delivery";
    if (mode == PAY_UPI) return "UPI (simulated)";
    return "Card (simulated)";
}
const char* payStatusName(int s) {
    if (s == PS_PAID) return "PAID";
    if (s == PS_REFUNDED) return "REFUNDED";
    return "PENDING";
}
double grandTotal(Order* o) {
    return o->itemTotal + o->deliveryFee + o->smallCartFee + o->platformFee;
}
// ---------- revenue split ----------
double shopEarning(Order* o) { return o->itemTotal * (100 - COMMISSION_PERCENT) / 100; }
double agentEarning(Order* o) { return o->deliveryFee * AGENT_SHARE_PERCENT / 100; }
double platformEarning(Order* o) { return grandTotal(o) - shopEarning(o) - agentEarning(o); }
// ---------- shop allocation ----------
// A shop can serve the cart only if it is within range AND has ALL items in stock.
int findCandidates(int pid[], int qty[], int n, int custArea, int tried[], int triedCount, Candidate out[]) {
    int dist[AREA_N], parent[AREA_N];
    dijkstra(custArea, dist, parent);   // roads are two-way, so this is shop -> customer too
    int count = 0;
    for (int s = 0; s < shopCount; s++) {
        bool skip = false;
        for (int t = 0; t < triedCount; t++)
            if (tried[t] == shops[s].id) skip = true;
        if (skip) continue;
        int d = dist[shops[s].areaNode];
        if (d > MAX_SERVICE_KM) continue;
        double total = 0;
        bool ok = true;
        for (int i = 0; i < n && ok; i++) {
            InvNode* node = inventory.find(shops[s].id, pid[i]);
            if (node == NULL || node->stock < qty[i]) ok = false;
            else total += node->price * qty[i];
        }
        if (!ok) continue;
        out[count].shopIndex = s;
        out[count].dist = d;
        out[count].itemTotal = total;
        out[count].deliveryFee = BASE_DELIVERY_FEE + FEE_PER_KM * d;
        out[count].grand = total + out[count].deliveryFee;
        count++;
    }
    return count;
}
// mode 1 = nearest, 2 = cheapest items, 3 = best overall (lowest item total + delivery fee)
bool isBetter(const Candidate& a, const Candidate& b, int mode) {
    if (mode == 1) {
        if (a.dist != b.dist) return a.dist < b.dist;
        return a.itemTotal < b.itemTotal;
    }
    if (mode == 2) {
        if (a.itemTotal != b.itemTotal) return a.itemTotal < b.itemTotal;
        return a.dist < b.dist;
    }
    if (a.grand != b.grand) return a.grand < b.grand;
    return a.dist < b.dist;
}
void sortCandidates(Candidate c[], int n, int mode) {   // bubble sort
    for (int i = 0; i < n - 1; i++)
        for (int j = 0; j < n - 1 - i; j++)
            if (isBetter(c[j + 1], c[j], mode)) {
                Candidate t = c[j]; c[j] = c[j + 1]; c[j + 1] = t;
            }
}
// gives the order to a shop: prices, stock reservation, fees, and joins the shop queue
void assignShopToOrder(Order* o, int shopIndex, int dist) {
    Shop* s = &shops[shopIndex];
    o->shopId = s->id;
    o->itemTotal = 0;
    for (int i = 0; i < o->itemCount; i++) {
        InvNode* node = inventory.find(s->id, o->items[i].productId);
        o->items[i].price = node->price;
        node->stock -= o->items[i].qty;                 // reserve stock now
        o->itemTotal += node->price * o->items[i].qty;
    }
    o->deliveryFee = BASE_DELIVERY_FEE + FEE_PER_KM * dist;
    o->smallCartFee = (o->itemTotal < MIN_CART_VALUE) ? SMALL_CART_FEE : 0;
    o->platformFee = PLATFORM_FEE;
    s->pending.enqueue(o);
}
void restoreStock(Order* o) {
    for (int i = 0; i < o->itemCount; i++) {
        InvNode* node = inventory.find(o->shopId, o->items[i].productId);
        if (node != NULL) node->stock += o->items[i].qty;
    }
}
// shop cannot fulfil: free the stock and try the next best shop
void rejectOrder(Order* o, Shop* s) {
    changeStatus(o, ST_REJECTED);
    restoreStock(o);
    if (o->triedCount < MAX_TRIED) o->tried[o->triedCount++] = s->id;
    cout << "Order #" << o->id << " rejected by your shop.\n";
 int pid[MAX_ITEMS], qty[MAX_ITEMS];
    for (int i = 0; i < o->itemCount; i++) { pid[i] = o->items[i].productId; qty[i] = o->items[i].qty; }
    Candidate cand[MAX_SHOPS];
    int n = 0;
    if (o->triedCount < MAX_TRIED)
        n = findCandidates(pid, qty, o->itemCount, o->deliveryArea, o->tried, o->triedCount, cand);
    if (n == 0) {
        cout << "No other shop can fulfil it. Order stays REJECTED.\n";
        refundIfPaid(o);
        return;
    }
sortCandidates(cand, n, o->allocMode);
    changeStatus(o, ST_PLACED);
    assignShopToOrder(o, cand[0].shopIndex, cand[0].dist);
    cout << "Order #" << o->id << " re-allocated to " << shops[cand[0].shopIndex].name
         << ". New bill: " << money(grandTotal(o)) << "\n";
}
// ---------- ETA ----------
// ETA = packing time + queue wait + agent coming to the shop + shop -> customer travel
int estimateEta(int shopIndex, int dist) {
    int depth = shops[shopIndex].pending.count(ST_PLACED, shops[shopIndex].id);
    int eta = PACK_TIME_MIN + depth * QUEUE_WAIT_MIN + dist * MIN_PER_KM;
    int d = 0;
    // nearest free agent (Dijkstra from the shop area)
    int distArr[AREA_N], parent[AREA_N];
    dijkstra(shops[shopIndex].areaNode, distArr, parent);
    int best = INF;
    for (int i = 0; i < userCount; i++) {
        if (users[i]->role != ROLE_AGENT) continue;
        DeliveryAgent* a = static_cast<DeliveryAgent*>(users[i]);
        if (a->isFree && distArr[a->currentArea] < best) best = distArr[a->currentArea];
    }
    d = best;
    if (d >= INF) eta += NO_AGENT_WAIT_MIN;
    else eta += d * MIN_PER_KM;
    return eta;
}
