// shopkeeper takes orders from the FRONT of the queue (first come, first served)
void Shopkeeper::processNextOrder() {
    Shop* s = myShop();
    s->pending.skipInvalid(ST_PLACED, s->id);
    Order* o = s->pending.peek();
    if (o == NULL) { cout << "No new orders waiting.\n"; return; }
    cout << "\nNext order in your queue:\n";
    printOrderDetails(o);
    cout << "1. Accept\n2. Reject (cannot fulfil)\n0. Back\n";
    int c = readInt("Choice: ", 0, 2);
    if (c == 0) return;
    s->pending.dequeue();
    if (c == 1) {
        changeStatus(o, ST_ACCEPTED);
        cout << "Order accepted. Pack it, then mark it as packed.\n";
    } else {
        rejectOrder(o, s);
    }
    saveAll();
}
void Shopkeeper::packOrders() {
    Shop* s = myShop();
    int found = 0;
    cout << "\nAccepted orders waiting to be packed:\n";
    for (Order* o = orderHead; o != NULL; o = o->next)
        if (o->shopId == s->id && o->status == ST_ACCEPTED) {
            printf("  Order #%d  %s  %d item line(s)\n", o->id, money(o->itemTotal).c_str(), o->itemCount);
            found++;
        }
if (found == 0) { cout << "  (none)\n"; return; }
    int oid = readInt("Order id (0 = back): ", 0, 999999);
    if (oid == 0) return;
    Order* o = findOrder(oid);
    if (o == NULL || o->shopId != s->id || o->status != ST_ACCEPTED) {
        cout << "That is not an accepted order of your shop.\n";
        return;
    }
cout << "1. Mark as packed (ready for pickup)\n2. Cannot fulfil (reject)\n0. Back\n";
    int c = readInt("Choice: ", 0, 2);
    if (c == 1) {
        changeStatus(o, ST_PACKED);
        cout << "Order #" << o->id << " is packed.\n";
        dispatchOrder(o);
        saveAll();
    } else if (c == 2) {
        rejectOrder(o, s);
        saveAll();
    }
}
void Shopkeeper::shopOrders() {
    Shop* s = myShop();
    double earned = 0;
    int delivered = 0;
    printf("\n%-6s %-17s %-15s %-12s %s\n", "Order", "Placed at", "Status", "Items", "Customer");
    int shown = 0;
for (Order* o = orderHead; o != NULL; o = o->next) {
        if (o->shopId != s->id) continue;
        User* u = findUser(o->customerId);
        printf("#%-5d %-17s %-15s %-12s %s\n", o->id, timeText(o->createdAt).c_str(),
               STATUS_NAME[o->status], money(o->itemTotal).c_str(), u ? u->name.c_str() : "?");
        shown++;
        if (o->status == ST_DELIVERED) { earned += shopEarning(o); delivered++; }
    }
if (shown == 0) cout << "  (no orders yet)\n";
    printf("Delivered orders: %d | Your earnings after %.0f%% commission: %s\n",
           delivered, COMMISSION_PERCENT, money(earned).c_str());
}
void Shopkeeper::menu() {
    if (myShop() == NULL) {
        cout << "You have no shop yet. Let's create it.\n";
        createShop();
        if (myShop() == NULL) return;
    }
while (true) {
        Shop* s = myShop();
        s->pending.skipInvalid(ST_PLACED, s->id);
        printf("\n===== SHOPKEEPER: %s (%s) =====\n", s->name.c_str(), AREA_NAME[s->areaNode]);
        printf("New orders waiting: %d\n", s->pending.count(ST_PLACED, s->id));
        cout << "1. Add / update a product\n2. Remove a product\n3. View my inventory\n"
             << "4. Process next new order (accept / reject)\n5. Mark accepted orders as packed\n"
             << "6. My orders and earnings\n0. Logout\n";
        int c = readInt("Choice: ", 0, 6);
        if (c == 0) return;
        if (c == 1) addUpdateProduct();
        else if (c == 2) removeProduct();
        else if (c == 3) viewInventory();
        else if (c == 4) processNextOrder();
        else if (c == 5) packOrders();
        else shopOrders();
    }
}
