// DELIVERY AGENT: rider dispatch (Dijkstra), delivery steps, earnings

// assigns the nearest free agent to a packed order; false if nobody is free
bool tryAssignAgent(Order* o) {
    Shop* s = findShop(o->shopId);
    int dist[AREA_N], parent[AREA_N];
    dijkstra(s->areaNode, dist, parent);
    DeliveryAgent* best = NULL;
    int bestDist = INF;
    for (int i = 0; i < userCount; i++) {
        if (users[i]->role != ROLE_AGENT) continue;
        DeliveryAgent* a = static_cast<DeliveryAgent*>(users[i]);
        if (a->isFree && dist[a->currentArea] < bestDist) { bestDist = dist[a->currentArea]; best = a; }
    }
    if (best == NULL) return false;

    int p1[MAX_ROUTE], p2[MAX_ROUTE];
    int l1 = buildPath(best->currentArea, s->areaNode, p1);   // agent -> shop
    int l2 = buildPath(s->areaNode, o->deliveryArea, p2);     // shop -> customer
    if (l1 == 0 || l2 == 0 || l1 + l2 - 1 > MAX_ROUTE) return false;
    int len = 0;
    for (int i = 0; i < l1; i++) o->path[len++] = p1[i];
    for (int i = 1; i < l2; i++) o->path[len++] = p2[i];
    o->pathLen = len;
    o->shopIdx = l1 - 1;
    o->pathPos = 0;
    o->agentId = best->id;
    best->isFree = false;
    changeStatus(o, ST_AGENT_ASSIGNED);
    return true;
}

void dispatchOrder(Order* o) {
    if (tryAssignAgent(o)) {
        User* a = findUser(o->agentId);
        cout << "Delivery agent " << a->name << " assigned to order #" << o->id << ".\n";
    } else {
        dispatchQueue.enqueue(o);
        cout << "No agent is free. Order #" << o->id << " is waiting in the dispatch queue.\n";
    }
}

// when an agent becomes free, serve waiting orders in first-come order
void processDispatchQueue() {
    while (!dispatchQueue.empty()) {
        Order* o = dispatchQueue.peek();
        if (o->status != ST_PACKED) { dispatchQueue.dequeue(); continue; }
        if (!tryAssignAgent(o)) break;
        dispatchQueue.dequeue();
    }
}

Order* DeliveryAgent::currentOrder() {
    for (Order* o = orderHead; o != NULL; o = o->next)
        if (o->agentId == id && (o->status == ST_AGENT_ASSIGNED || o->status == ST_PICKED_UP)) return o;
    return NULL;
}

void DeliveryAgent::showStatus() {
    printf("\nYou are at: %s | %s\n", AREA_NAME[currentArea], isFree ? "FREE for orders" : "BUSY with a delivery");
    Order* o = currentOrder();
    if (o == NULL) { cout << "No active delivery.\n"; return; }
    Shop* s = findShop(o->shopId);
    User* c = findUser(o->customerId);
    printf("Active order #%d | Status: %s\n", o->id, STATUS_NAME[o->status]);
    printf("Pick up at: %s (%s)\n", s->name.c_str(), AREA_NAME[s->areaNode]);
    printf("Deliver to: %s | Customer: %s %s\n", AREA_NAME[o->deliveryArea],
           c ? c->name.c_str() : "?", c ? c->phone.c_str() : "");
    printf("Collect on delivery: %s\n", (o->paymentMode == PAY_COD) ? money(grandTotal(o)).c_str() : "Rs.0.00 (already paid)");
    printRoute(o);
}
void DeliveryAgent::moveNext() {
    Order* o = currentOrder();
    if (o == NULL) { cout << "No active delivery.\n"; return; }
    if (o->status == ST_AGENT_ASSIGNED && o->pathPos == o->shopIdx) {
        cout << "You are at the shop. Confirm the pickup first.\n";
        return;
    }
    if (o->pathPos >= o->pathLen - 1) {
        cout << "You are at the customer's area. Confirm the delivery.\n";
        return;
    }
    o->pathPos++;
    currentArea = o->path[o->pathPos];
    cout << "You moved to " << AREA_NAME[currentArea] << ".\n";
    saveAll();
}

void DeliveryAgent::confirmPickup() {
    Order* o = currentOrder();
    if (o == NULL) { cout << "No active delivery.\n"; return; }
    if (o->status != ST_AGENT_ASSIGNED) { cout << "Pickup is already done.\n"; return; }
    if (o->pathPos != o->shopIdx) { cout << "You are not at the shop yet. Keep moving.\n"; return; }
    changeStatus(o, ST_PICKED_UP);
    cout << "Order #" << o->id << " picked up. Head to the customer.\n";
    saveAll();
}

void DeliveryAgent::confirmDelivery() {
    Order* o = currentOrder();
    if (o == NULL) { cout << "No active delivery.\n"; return; }
    if (o->status != ST_PICKED_UP) { cout << "Pick up the order first.\n"; return; }
    if (o->pathPos != o->pathLen - 1) { cout << "You have not reached the customer's area yet.\n"; return; }
    changeStatus(o, ST_DELIVERED);
    Payment* p = findPayment(o->id);
    if (p != NULL && p->status == PS_PENDING) p->status = PS_PAID;   // cash collected
    isFree = true;
    currentArea = o->deliveryArea;
    printf("Delivered order #%d. You earned %s.\n", o->id, money(agentEarning(o)).c_str());
    processDispatchQueue();           // maybe a waiting order can be given to this agent
    saveAll();
}

void DeliveryAgent::earnings() {
    double total = 0;
    int count = 0;
    printf("\n%-6s %-17s %s\n", "Order", "Placed at", "Earning");
    for (Order* o = orderHead; o != NULL; o = o->next)
        if (o->agentId == id && o->status == ST_DELIVERED) {
            printf("#%-5d %-17s %s\n", o->id, timeText(o->createdAt).c_str(), money(agentEarning(o)).c_str());
            total += agentEarning(o);
            count++;
        }
    printf("Deliveries: %d | Total earnings (%.0f%% of delivery fees): %s\n", count, AGENT_SHARE_PERCENT, money(total).c_str());
}

void DeliveryAgent::menu() {
    processDispatchQueue();           // new or returning free agent takes waiting orders
    saveAll();
    while (true) {
        printf("\n===== DELIVERY AGENT: %s =====\n", name.c_str());
        cout << "1. My status and current delivery\n2. Move to next area on route\n"
             << "3. Confirm pickup at shop\n4. Confirm delivery to customer\n"
             << "5. My earnings\n0. Logout\n";
        int c = readInt("Choice: ", 0, 5);
        if (c == 0) return;
        if (c == 1) showStatus();
        else if (c == 2) moveNext();
        else if (c == 3) confirmPickup();
        else if (c == 4) confirmDelivery();
        else earnings();
    }
}

