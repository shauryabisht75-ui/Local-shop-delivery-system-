string timeText(long long t) {
    time_t tt = (time_t)t;
    char buf[40];
    strftime(buf, sizeof(buf), "%d-%m-%Y %H:%M", localtime(&tt));
    return string(buf);
}
int splitLine(const string& line, string parts[], int maxParts) {
    int count = 0;
    string cur = "";
    for (size_t i = 0; i < line.size(); i++) {
        if (line[i] == '|') {
            if (count < maxParts) parts[count++] = cur;
            cur = "";
        } else if (line[i] != '\r') cur += line[i];
    }
    if (count < maxParts) parts[count++] = cur;
    return count;
}
// ---------- area graph (adjacency matrix, distances in km) ----------
int graph[AREA_N][AREA_N];

void addRoad(int a, int b, int km) { graph[a][b] = km; graph[b][a] = km; }

void defaultRoads() {
    addRoad(0, 1, 2); addRoad(0, 2, 1); addRoad(0, 3, 3); addRoad(1, 4, 2);
    addRoad(2, 3, 2); addRoad(2, 5, 3); addRoad(3, 6, 4); addRoad(4, 5, 1);
    addRoad(5, 7, 4); addRoad(6, 7, 2);
}
// Dijkstra shortest distance from src to every area (also fills parent[])
void dijkstra(int src, int dist[], int parent[]) {
    bool done[AREA_N];
    for (int i = 0; i < AREA_N; i++) { dist[i] = INF; parent[i] = -1; done[i] = false; }
    dist[src] = 0;
    for (int step = 0; step < AREA_N; step++) {
        int u = -1;
        for (int i = 0; i < AREA_N; i++)
            if (!done[i] && (u == -1 || dist[i] < dist[u])) u = i;
        if (u == -1 || dist[u] >= INF) break;
        done[u] = true;
        for (int v = 0; v < AREA_N; v++)
            if (graph[u][v] > 0 && dist[u] + graph[u][v] < dist[v]) {
                dist[v] = dist[u] + graph[u][v];
                parent[v] = u;
            }
    }
}
// fills path[] with the areas from src to dst, returns its length (0 = no road)
int buildPath(int src, int dst, int path[]) {
    int dist[AREA_N], parent[AREA_N];
    dijkstra(src, dist, parent);
    if (dist[dst] >= INF) return 0;
    int temp[AREA_N], len = 0, cur = dst;
    while (cur != -1) { temp[len++] = cur; cur = parent[cur]; }
    for (int i = 0; i < len; i++) path[i] = temp[len - 1 - i];
    return len;
}
