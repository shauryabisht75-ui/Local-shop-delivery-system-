// adds a product to the master catalog; returns its id (0 = duplicate or full)
int addProduct(const string& name, const string& category, const string& unit) {
    if (productCount >= MAX_PRODUCTS) return 0;
    if (nameTable.find(toLower(name)) != 0) return 0;
    Product& p = products[productCount++];
    p.id = nextProductId++;
    p.name = name; p.category = category; p.unit = unit;
    nameTable.insert(toLower(name), p.id);
    return p.id;
}
// insertion sort of catalog indexes by product name
void sortedCatalog(int idx[]) {
    for (int i = 0; i < productCount; i++) idx[i] = i;
    for (int i = 1; i < productCount; i++) {
        int k = idx[i], j = i - 1;
        while (j >= 0 && toLower(products[idx[j]].name) > toLower(products[k].name)) {
            idx[j + 1] = idx[j];
            j--;
        }
        idx[j + 1] = k;
    }
}
// how many shops have this product in stock; 'low' = lowest price among them
int stockingShops(int productId, double& low) {
    int c = 0;
    low = 0;
    for (int i = 0; i < shopCount; i++) {
        InvNode* n = inventory.find(shops[i].id, productId);
        if (n != NULL && n->stock > 0) {
            if (c == 0 || n->price < low) low = n->price;
            c++;
        }
    }
    return c;
}
