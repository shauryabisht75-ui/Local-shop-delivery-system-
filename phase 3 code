    ifstream f("area_graph.txt");
    if (!f.is_open()) { defaultRoads(); saveGraph(); return; }
    string line, p[6];
    int roads = 0;
    while (getline(f, line)) {
        if (splitLine(line, p, 6) < 3) continue;
        int a = atoi(p[0].c_str()), b = atoi(p[1].c_str()), km = atoi(p[2].c_str());
        if (a >= 0 && a < AREA_N && b >= 0 && b < AREA_N && km > 0) { addRoad(a, b, km); roads++; }
    }
    if (roads == 0) { defaultRoads(); saveGraph(); }
}

// ---------- loading ----------
void loadAll() {
    string line, p[20];
    ifstream f;

    f.open("users.txt");
    while (getline(f, line) && userCount < MAX_USERS) {
        if (splitLine(line, p, 20) < 6) continue;
        User* u = makeUser(atoi(p[4].c_str()));
        u->id = atoi(p[0].c_str()); u->name = p[1]; u->phone = p[2];
        u->passHash = p[3]; u->areaNode = atoi(p[5].c_str());
        if (u->areaNode < 0 || u->areaNode >= AREA_N) u->areaNode = 0;
        users[userCount++] = u;
        if (u->id >= nextUserId) nextUserId = u->id + 1;
    }
    f.close();

    f.open("agents.txt");
    while (getline(f, line)) {
        if (splitLine(line, p, 20) < 3) continue;
        User* u = findUser(atoi(p[0].c_str()));
        if (u == NULL || u->role != ROLE_AGENT) continue;
        DeliveryAgent* a = static_cast<DeliveryAgent*>(u);
        a->currentArea = atoi(p[1].c_str());
        if (a->currentArea < 0 || a->currentArea >= AREA_N) a->currentArea = 0;
        a->isFree = (atoi(p[2].c_str()) == 1);
    }
    f.close();

    f.open("products.txt");
    while (getline(f, line) && productCount < MAX_PRODUCTS) {
        if (splitLine(line, p, 20) < 4) continue;
        Product& pr = products[productCount++];
        pr.id = atoi(p[0].c_str()); pr.name = p[1]; pr.category = p[2]; pr.unit = p[3];
        nameTable.insert(toLower(pr.name), pr.id);
        if (pr.id >= nextProductId) nextProductId = pr.id + 1;
    }
    f.close();

    f.open("shops.txt");
    while (getline(f, line) && shopCount < MAX_SHOPS) {
        if (splitLine(line, p, 20) < 4) continue;
        Shop& s = shops[shopCount++];
        s.id = atoi(p[0].c_str()); s.ownerId = atoi(p[1].c_str()); s.name = p[2];
        s.areaNode = atoi(p[3].c_str());
        if (s.areaNode < 0 || s.areaNode >= AREA_N) s.areaNode = 0;
        if (s.id >= nextShopId) nextShopId = s.id + 1;
    }
    f.close();

    f.open("inventory.txt");
    while (getline(f, line)) {
        if (splitLine(line, p, 20) < 4) continue;
        inventory.set(atoi(p[0].c_str()), atoi(p[1].c_str()), atof(p[2].c_str()), atoi(p[3].c_str()));
    }
    f.close();

    f.open("orders.txt");
    while (getline(f, line)) {
        if (splitLine(line, p, 20) < 17) continue;
        Order* o = newOrderNode();
        o->id = atoi(p[0].c_str());
        if (o->id >= nextOrderId) nextOrderId = o->id + 1;
        o->customerId = atoi(p[1].c_str()); o->shopId = atoi(p[2].c_str()); o->agentId = atoi(p[3].c_str());
        o->status = atoi(p[4].c_str());
        o->itemTotal = atof(p[5].c_str()); o->deliveryFee = atof(p[6].c_str());
        o->smallCartFee = atof(p[7].c_str()); o->platformFee = atof(p[8].c_str());
        o->paymentMode = atoi(p[9].c_str()); o->allocMode = atoi(p[10].c_str());
        o->deliveryArea = atoi(p[11].c_str()); o->createdAt = atoll(p[12].c_str());
        o->pathPos = atoi(p[13].c_str()); o->shopIdx = atoi(p[14].c_str());
        if (p[15] != "-") {
            string cur = "";
            for (size_t i = 0; i <= p[15].size(); i++) {
                if (i == p[15].size() || p[15][i] == ';') {
                    if (!cur.empty() && o->pathLen < MAX_ROUTE) o->path[o->pathLen++] = atoi(cur.c_str());
                    cur = "";
                } else cur += p[15][i];
            }
        }
        if (p[16] != "-") {
            string cur = "";
            for (size_t i = 0; i <= p[16].size(); i++) {
                if (i == p[16].size() || p[16][i] == ';') {
                    if (!cur.empty() && o->triedCount < MAX_TRIED) o->tried[o->triedCount++] = atoi(cur.c_str());
                    cur = "";
                } else cur += p[16][i];
            }
        }
    }
    f.close();

    f.open("order_items.txt");
    while (getline(f, line)) {
        if (splitLine(line, p, 20) < 4) continue;
        Order* o = findOrder(atoi(p[0].c_str()));
        if (o == NULL || o->itemCount >= MAX_ITEMS) continue;
        o->items[o->itemCount].productId = atoi(p[1].c_str());
        o->items[o->itemCount].qty = atoi(p[2].c_str());
        o->items[o->itemCount].price = atof(p[3].c_str());
        o->itemCount++;
    }
    f.close();

    f.open("payments.txt");
    while (getline(f, line) && paymentCount < MAX_PAYMENTS) {
        if (splitLine(line, p, 20) < 4) continue;
        Payment& pay = payments[paymentCount++];
        pay.id = atoi(p[0].c_str()); pay.orderId = atoi(p[1].c_str());
        pay.mode = atoi(p[2].c_str()); pay.status = atoi(p[3].c_str());
        if (pay.id >= nextPaymentId) nextPaymentId = pay.id + 1;
    }
    f.close();

    // rebuild the queues from the order list (list is in arrival order)
    for (Order* o = orderHead; o != NULL; o = o->next) {
        if (o->status == ST_PLACED) {
            Shop* s = findShop(o->shopId);
            if (s != NULL) s->pending.enqueue(o);
        } else if (o->status == ST_PACKED && o->agentId == 0) {
            dispatchQueue.enqueue(o);
        }
    }
}

User* findUserByPhone(const string& phone) {
    for (int i = 0; i < userCount; i++)
        if (users[i]->phone == phone) return users[i];
    return NULL;
}

void registerUser() {
    if (userCount >= MAX_USERS) { cout << "User limit reached.\n"; return; }
    cout << "\nRegister as: 1. Customer  2. Shopkeeper  3. Delivery Agent  0. Back\n";
    int role = readInt("Choice: ", 0, 3);
    if (role == 0) return;
    string name = readName("Your name: ");
    string phone;
    while (true) {
        phone = readLine("Phone number (10 digits): ");
        if (phone.size() != 10 || !isNumber(phone.substr(0, 5)) || !isNumber(phone.substr(5))) {
            cout << "  Phone must be exactly 10 digits.\n";
        } else if (findUserByPhone(phone) != NULL) {
            cout << "  This phone number is already registered.\n";
        } else break;
    }
    string pass;
    while (true) {
        pass = readLine("Password (at least 4 characters): ");
        if (pass.size() >= 4) break;
        cout << "  Password is too short.\n";
    }
    User* u = makeUser(role);
    u->id = nextUserId++;
    u->name = name; u->phone = phone; u->passHash = hashPassword(pass);
    if (role == ROLE_CUSTOMER) u->areaNode = chooseArea("Your area (number): ");
    if (role == ROLE_AGENT) {
        DeliveryAgent* a = static_cast<DeliveryAgent*>(u);
        a->currentArea = chooseArea("Area where you start (number): ");
        a->isFree = true;
    }
    users[userCount++] = u;
    saveAll();
    cout << "Registered successfully! You can log in now.\n";
}

void loginUser() {
    string phone = readLine("Phone number: ");
    string pass = readLine("Password: ");
    User* u = findUserByPhone(phone);
    if (u == NULL || u->passHash != hashPassword(pass)) {
        cout << "Wrong phone number or password.\n";
        return;
    }
    cout << "\nWelcome, " << u->name << "!\n";
    u->menu();
    saveAll();
}
