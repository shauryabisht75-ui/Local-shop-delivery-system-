void saveAll();   // defined in MODULE 6

string readLine(const string& prompt) {
    string s;
    cout << prompt;
    if (!getline(cin, s)) {
        cout << "\nInput closed. Saving and exiting.\n";
        saveAll();
        exit(0);
    }
    int a = 0, b = (int)s.size() - 1;
    while (a <= b && (s[a] == ' ' || s[a] == '\t' || s[a] == '\r')) a++;
    while (b >= a && (s[b] == ' ' || s[b] == '\t' || s[b] == '\r')) b--;
    return s.substr(a, b - a + 1);
}

bool isNumber(const string& s) {
    if (s.empty() || s.size() > 9) return false;
    for (size_t i = 0; i < s.size(); i++)
        if (s[i] < '0' || s[i] > '9') return false;
    return true;
}

// reads a whole number in [lo, hi]; keeps asking until the input is valid
int readInt(const string& prompt, int lo, int hi) {
    while (true) {
        string s = readLine(prompt);
        if (isNumber(s)) {
            int v = atoi(s.c_str());
            if (v >= lo && v <= hi) return v;
        }
        cout << "  Please enter a whole number from " << lo << " to " << hi << ".\n";
    }
}

// reads a money value like 45 or 45.50 in [lo, hi]
double readMoney(const string& prompt, double lo, double hi) {
    while (true) {
        string s = readLine(prompt);
        bool ok = !s.empty() && s.size() <= 9;
        int dots = 0, digits = 0;
        for (size_t i = 0; i < s.size(); i++) {
            if (s[i] == '.') dots++;
            else if (s[i] >= '0' && s[i] <= '9') digits++;
            else ok = false;
        }
        if (ok && dots <= 1 && digits > 0) {
            double v = atof(s.c_str());
            if (v >= lo && v <= hi) return v;
        }
        cout << "  Please enter an amount from " << lo << " to " << hi << ".\n";
    }
}
string cleanText(string s) {            // '|' and ';' are used in the data files
    for (size_t i = 0; i < s.size(); i++)
        if (s[i] == '|' || s[i] == ';') s[i] = ' ';
    return s;
}

string readName(const string& prompt) {
    while (true) {
        string s = cleanText(readLine(prompt));
        if (!s.empty() && s.size() <= 30) return s;
        cout << "  Enter 1 to 30 characters.\n";
    }
}
string toLower(string s) {
    for (size_t i = 0; i < s.size(); i++)
        if (s[i] >= 'A' && s[i] <= 'Z') s[i] = s[i] + 32;
    return s;
}

bool contains(const string& text, const string& key) {
    return text.find(key) != string::npos;
}
string hashPassword(const string& p) {  // simple djb2 hash, passwords are not stored as plain text
    unsigned long long h = 5381;
    for (size_t i = 0; i < p.size(); i++) h = h * 33 + (unsigned char)p[i];
    return to_string(h);
}

