int main() {
    int choice = -1;

    while (choice != 0) {
        cout << "\n===== Local Shop Delivery System =====\n";
        cout << "1. View all products\n";
        cout << "2. Compare prices\n";
        cout << "3. Place order\n";
        cout << "4. Accept next order\n";
        cout << "5. Deliver order\n";
        cout << "6. Track order\n";
        cout << "7. Show all orders\n";
        cout << "0. Exit\n";
        cout << "Enter choice: ";
        cin >> choice;

        if (cin.fail()) {
            cout << "Please enter a number\n";
            cin.clear();
            cin.ignore(1000, '\n');
            choice = -1;
            continue;
        }
        cin.ignore(1000, '\n');   // remove the Enter key

        if (choice == 1)
            showAll();
        else if (choice == 2)
            comparePrices();
        else if (choice == 3)
            placeOrder();
        else if (choice == 4)
            acceptOrder();
        else if (choice == 5)
            deliverOrder();
        else if (choice == 6)
            trackOrder();
        else if (choice == 7)
            showOrders();
        else if (choice != 0)
            cout << "Wrong choice\n";
    }

    cout << "Thank you\n";
    return 0;
}
