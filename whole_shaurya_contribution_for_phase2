#include <iostream>
#include <string>
using namespace std;


// ============================================================
// PART 1: CUSTOMER MODULE - products and price comparison
// ============================================================

// One product of one shop
struct Product {
    int id;
    string shopName;
    string name;
    int price;
    int stock;
};

// All products of all shops (sample data, same as database.sql)
Product products[6] = {
    {1, "Negi General Store", "Rice", 60, 50},
    {2, "Negi General Store", "Sugar", 45, 30},
    {3, "Negi General Store", "Tea", 120, 20},
    {4, "Devi Kirana", "Rice", 55, 40},
    {5, "Devi Kirana", "Sugar", 48, 25},
    {6, "Devi Kirana", "Salt", 20, 60}
};
int total = 6;   // number of products


// Show all products
void showAll() {
    cout << "\n--- All Products ---" << endl;
    for (int i = 0; i < total; i++) {
        cout << products[i].id << ". "
             << products[i].name << " | "
             << products[i].shopName << " | Rs "
             << products[i].price << " | Stock: "
             << products[i].stock << endl;
    }
}


// Bubble sort: lowest price comes first
// Compare two neighbours, swap them if the left one is costlier
void sortByPrice(Product list[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (list[j].price > list[j + 1].price) {
                Product temp = list[j];
                list[j] = list[j + 1];
                list[j + 1] = temp;
            }
        }
    }
}


// Compare prices of one product in different shops
void comparePrices() {
    string wanted;
    cout << "Enter product name (Rice / Sugar / Tea / Salt): ";
    getline(cin, wanted);

    // Step 1: copy all shops that sell this product into a new list
    Product found[6];
    int count = 0;
    for (int i = 0; i < total; i++) {
        if (products[i].name == wanted && products[i].stock > 0) {
            found[count] = products[i];
            count++;
        }
    }

    if (count == 0) {
        cout << "No shop has " << wanted << " in stock." << endl;
        return;
    }

    // Step 2: sort that list by price
    sortByPrice(found, count);

    // Step 3: print it (first one is the cheapest)
    cout << "\n--- Price comparison for " << wanted << " ---" << endl;
    for (int i = 0; i < count; i++) {
        cout << i + 1 << ". " << found[i].shopName
             << " - Rs " << found[i].price;
        if (i == 0) {
            cout << "  (Cheapest)";
        }
        cout << endl;
    }
}


// ============================================================
// PART 2: ORDER MODULE - order queue and linked list
// ============================================================

// status: 0 = Pending, 1 = Accepted, 2 = Delivered
struct Order {
    int id;
    char customer[30];
    char item[30];
    float price;
    int status;
    Order *next;
};

Order *head = NULL;      // first order of the linked list
Order *tail = NULL;      // last order of the linked list

Order *queueArr[100];    // queue of pending orders
int front = 0;
int rear = 0;

int orderCount = 0;      // used to give id to orders

void printStatus(int s) {
    if (s == 0)
        cout << "Pending";
    else if (s == 1)
        cout << "Accepted";
    else
        cout << "Delivered";
}

void placeOrder() {
    if (rear == 100) {
        cout << "Queue is full\n";
        return;
    }

    Order *n = new Order;
    orderCount++;
    n->id = orderCount;

    cout << "Enter customer name: ";
    cin >> n->customer;
    cout << "Enter item name: ";
    cin >> n->item;

    cout << "Enter price: ";
    cin >> n->price;
    while (cin.fail() || n->price <= 0) {
        cout << "Wrong price, enter again: ";
        cin.clear();
        cin.ignore(1000, '\n');
        cin >> n->price;
    }

    n->status = 0;
    n->next = NULL;

    // add in linked list
    if (head == NULL) {
        head = n;
        tail = n;
    } else {
        tail->next = n;
        tail = n;
    }

    // add in queue
    queueArr[rear] = n;
    rear++;

    cout << "Order placed, your order id is " << n->id << endl;
}

void acceptOrder() {
    if (front == rear) {
        cout << "No pending orders\n";
        return;
    }

    Order *n = queueArr[front];   // first order in queue
    front++;
    n->status = 1;
    cout << "Order " << n->id << " accepted\n";
}

Order *searchOrder(int id) {
    Order *temp = head;
    while (temp != NULL) {
        if (temp->id == id)
            return temp;
        temp = temp->next;
    }
    return NULL;
}

void deliverOrder() {
    int id;
    cout << "Enter order id: ";
    cin >> id;
    while (cin.fail()) {
        cout << "Enter a number: ";
        cin.clear();
        cin.ignore(1000, '\n');
        cin >> id;
    }

    Order *n = searchOrder(id);
    if (n == NULL)
        cout << "Order not found\n";
    else if (n->status != 1)
        cout << "Order is not accepted yet\n";
    else {
        n->status = 2;
        cout << "Order " << id << " delivered\n";
    }
}

void trackOrder() {
    int id;
    cout << "Enter order id: ";
    cin >> id;
    while (cin.fail()) {
        cout << "Enter a number: ";
        cin.clear();
        cin.ignore(1000, '\n');
        cin >> id;
    }

    Order *n = searchOrder(id);
    if (n == NULL) {
        cout << "Order not found\n";
    } else {
        cout << "Order " << n->id << " (" << n->item << ") is ";
        printStatus(n->status);
        cout << endl;
    }
}

void showOrders() {
    if (head == NULL) {
        cout << "No orders yet\n";
        return;
    }
    Order *temp = head;
    while (temp != NULL) {
        cout << temp->id << "  " << temp->customer << "  " << temp->item
             << "  Rs." << temp->price << "  ";
        printStatus(temp->status);
        cout << endl;
        temp = temp->next;
    }
}


