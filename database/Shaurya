-- ------------------------------------------------------------
-- STEP 1: Create the database and select it
-- ------------------------------------------------------------
CREATE DATABASE IF NOT EXISTS local_shop_delivery;
USE local_shop_delivery;


-- ------------------------------------------------------------
-- STEP 2: users table
-- One table for all 3 types of users (matches the User base
-- class and its Shopkeeper / Customer / DeliveryAgent children).
-- The 'role' column tells us which type the user is.
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS users (
    user_id    INT AUTO_INCREMENT PRIMARY KEY,
    name       VARCHAR(50) NOT NULL,
    phone      VARCHAR(15) NOT NULL UNIQUE,
    role       ENUM('shopkeeper', 'customer', 'agent') NOT NULL,
    area       VARCHAR(50) NOT NULL,   -- village/area name (used later for the graph)
    shop_name  VARCHAR(50) NULL        -- filled only when role = 'shopkeeper'
);


-- ------------------------------------------------------------
-- STEP 3: products table
-- Each product belongs to one shopkeeper (shop).
-- The same product (e.g. Rice) can appear in many shops with
-- different prices, which is what price comparison uses.
-- CHECK rules stop negative price / negative stock, because
-- wrong input crashed our program earlier.
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS products (
    product_id     INT AUTO_INCREMENT PRIMARY KEY,
    shopkeeper_id  INT NOT NULL,
    product_name   VARCHAR(50) NOT NULL,
    price          DECIMAL(8,2) NOT NULL CHECK (price > 0),
    stock          INT NOT NULL DEFAULT 0 CHECK (stock >= 0),
    FOREIGN KEY (shopkeeper_id) REFERENCES users(user_id)
);


-- ------------------------------------------------------------
-- STEP 4: orders table
-- status follows the order flow: pending -> accepted -> delivered
-- (same flow as the queue + linked list in C++).
-- agent_id stays NULL until a delivery agent takes the order.
-- Payment is cash on delivery, so no payment column is needed.
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS orders (
    order_id     INT AUTO_INCREMENT PRIMARY KEY,
    customer_id  INT NOT NULL,
    product_id   INT NOT NULL,
    agent_id     INT NULL,
    quantity     INT NOT NULL CHECK (quantity > 0),
    total_price  DECIMAL(10,2) NOT NULL,
    status       ENUM('pending', 'accepted', 'delivered') NOT NULL DEFAULT 'pending',
    order_time   TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (customer_id) REFERENCES users(user_id),
    FOREIGN KEY (product_id)  REFERENCES products(product_id),
    FOREIGN KEY (agent_id)    REFERENCES users(user_id)
);


