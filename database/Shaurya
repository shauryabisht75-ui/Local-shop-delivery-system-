-- TEST QUERIES (one for each completed feature)
-- ============================================================

-- 1) Shopkeeper: VIEW stock of shop 1
SELECT product_id, product_name, price, stock
FROM products
WHERE shopkeeper_id = 1;

-- 2) Shopkeeper: ADD a product
INSERT INTO products (shopkeeper_id, product_name, price, stock)
VALUES (1, 'Biscuit Pack', 10.00, 100);

-- 3) Shopkeeper: UPDATE price and stock
UPDATE products
SET price = 62.00, stock = 45
WHERE product_id = 1;

-- 4) Shopkeeper: DELETE a product
DELETE FROM products
WHERE product_id = 3;

-- 5) Customer: BROWSE all products with their shop name
SELECT p.product_id, p.product_name, p.price, u.shop_name
FROM products p
JOIN users u ON p.shopkeeper_id = u.user_id;

-- 6) Customer: PRICE COMPARISON - same product, cheapest shop first
SELECT u.shop_name, p.product_name, p.price
FROM products p
JOIN users u ON p.shopkeeper_id = u.user_id
WHERE p.product_name = 'Rice 1kg'
ORDER BY p.price ASC;

